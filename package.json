{
  "name": "price-lantern",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "package": "python3 scripts/package.py",
    "verify:package": "python3 scripts/verify-package.py",
    "package:source": "python3 scripts/package-source.py",
    "verify:source": "python3 scripts/verify-source.py",
    "check": "npm test && npm run package && npm run verify:package && npm run package:source && npm run verify:source"
  }
}
